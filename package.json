{
  "name": "fleet-readiness",
  "version": "0.1.0",
  "private": true,
  "description": "Truck readiness inspections with photo capture, 360 viewer, TMS sync and Telegram driver bot",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
