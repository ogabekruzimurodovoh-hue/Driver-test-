# --- Server ---------------------------------------------------------------
PORT=3000
# Public HTTPS URL (Telegram and phone cameras need HTTPS in production)
PUBLIC_URL=https://readiness.example.com
# Dispatcher login (Basic auth, any username). REQUIRED in production.
DASHBOARD_PASSWORD=change-me
DATA_DIR=./data
# Demo drivers and trucks are created when the database is empty
SEED_DEMO=true

# --- Telegram bot (optional) ---------------------------------------------
# Create with @BotFather
TELEGRAM_BOT_TOKEN=
# Any random string (A-Z a-z 0-9 _ -); Telegram echoes it on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Chat/group id that receives every completed inspection (optional)
TELEGRAM_DISPATCH_CHAT_ID=

# --- DataTruck / TMS (optional) -------------------------------------------
# Leave empty to run without TMS sync. Endpoints must be confirmed with
# DataTruck support: paths are configurable below.
TMS_BASE_URL=
TMS_API_KEY=
TMS_DRIVERS_PATH=/drivers
TMS_TRUCKS_PATH=/trucks
TMS_INSPECTIONS_PATH=/inspections
